/*
 * DELIVER Pipeline Configuration
 *
 * Usage:
 *   nextflow run pipeline/main.nf -profile longleaf -params-file params.yml
 *
 * Profiles:
 *   longleaf  — UNC Longleaf HPC (SLURM)
 *   local     — local execution (development)
 */

// ============================================================================
// PARAMETERS
// ============================================================================

params {
    // Output
    out_dir         = null

    // Selection metadata (written into the generated decode.yaml)
    selection_id          = "selection"
    target_id             = "target"
    selection_condition   = "-"
    date_ran              = ""
    additional_info       = ""

    // FASTQ input files (for FULL and FROM_FASTQ)
    read_1         = null   // R1 files (list)
    read_2         = null   // R2 files (list), null = single-end

    // Pre-merged FASTQ entry point (alternative to read_1): skips PREPROCESS
    // entirely and feeds this single file straight into DELI (splitFastq →
    // decode). Use it to recover a run whose FASTP_MERGE/DECOMPRESS output
    // already exists in a work dir but is not reachable via -resume (e.g. the
    // retry-slot resume gap documented in docs/nextflow-resume-retry-cache-issue.md).
    merged_fastq   = null   // single .fastq/.fastq.gz path (local or gs://)

    // Libraries to decode against
    libraries             = []

    // Decode settings
    library_error_tolerance  = 2
    min_library_overlap      = 8
    revcomp                  = "YES"
    demultiplexer_algorithm  = "regex"
    demultiplexer_mode   = "single"
    realign                  = "NO"
    wiggle                   = "YES"

    // Preprocessing parameters
    fastp_threads   = 8    // increase for large files
    fastqc_threads  = 2    // one thread per input file (R1 [+ R2])
    ora_reference   = null // path to Illumina ORA reference (oradata) dir; only
                           // needed for reference-based .ora inputs (else leave null)

    // DELi runtime parameters
    deli_data_dir   = null
    config_file     = null
    chunk_size      = 1000000
    prefix          = ""
    debug           = false
    save_fastq_info = false
    save_failed     = false

    // Pre-counted parquet entry point (alternative to read_1)
    counts          = null

    // GCP Cloud Batch provisioning (gcp/gcp_test profiles only). Spot VMs are
    // ~60-90% cheaper but can be reclaimed mid-task. Pass --spot false for
    // recovery resumes where only a few long serial tasks remain: besides
    // avoiding wasted reruns, a first attempt that gets preempted and then
    // succeeds via a Nextflow-level retry is INVISIBLE to later -resume
    // (retry-slot gap — docs/nextflow-resume-retry-cache-issue.md), so
    // avoiding preemption also protects resume caching.
    spot            = true

    // Deduplication behaviour when the same compound_id appears more than once:
    //   "fail" — abort and list the offending IDs (default; catches unexpected duplicates)
    //   "sum"  — merge duplicate rows by summing corrected_count (and raw_count if present)
    on_duplicate_compound_id = "fail"

    // Path to a pre-computed library_dict.json. When set, BUILD_LIBRARY_DICT is skipped.
    // Useful in counts mode when deli_data_dir is not available.
    library_dict = null

    // Directory for the trace/report files below (submit.slurm passes --log_dir,
    // the same directory as the launcher/nextflow logs). Falls back to a local
    // pipeline_info/ dir for manual `nextflow run` invocations that don't set it.
    log_dir = null
}

// ============================================================================
// DEFAULT PROCESS SETTINGS
// ============================================================================

process {
    cpus   = 1
    memory = 4.GB

    withName: 'CollectDecodeChunks' {
        memory = 16.GB
    }
}

// ============================================================================
// DYNAMIC, SIZE-BASED MEMORY
// ============================================================================
// For "whole-file" processes — steps whose input is the full sample rather
// than a bounded chunk — required memory scales with campaign size, so a
// fixed allocation that's safe for a small selection can OOM on a large one
// (this is what happened to POSTPROCESS:NORMALIZE on the 2026-08 SGCDEL
// Camp1 run: 16.GB fixed, comfortable for <200MB counts.parquet, OOM-killed
// on the ~1GB counts.parquet from larger selections).
//
// Chunked steps (DecodeChunk, CountChunk) are deliberately NOT included
// here: sacct history across 16k+ DecodeChunk runs and 1.6k+ CountChunk runs
// shows flat, bounded memory use regardless of overall sample size, since
// each handles one fixed-size chunk (params.chunk_size reads / 500_000-line
// ndjson chunks) — dynamic sizing would add complexity with no benefit.
//
// gbPerInputGB is a rough multiplier calibrated from sacct MaxRSS history
// and direct profiling against real campaign inputs (2026-08-17 investigation
// into SGCDEL Camp1 OOM failures — see git log for that commit's notes).
// baseGB is a floor: never request less than the previous known-safe fixed
// value. task.attempt adds headroom on retry, so an under-calibrated
// multiplier still self-corrects on retry instead of failing every time the
// way the old fixed allocations did.
def sizeMem(inputs, gbPerInputGB, baseGB, attempt) {
    def files = (inputs instanceof List) ? inputs.flatten() : [inputs]
    def totalBytes = files.findAll { it != null }.collect { it.size() }.sum() ?: 0
    def scaledGB = (totalBytes / (1024L**3)) * gbPerInputGB
    def gb = Math.max(baseGB, Math.ceil(scaledGB) as long) * attempt
    return "${gb} GB"
}

// For processes too small/fixed to justify a sizeMem-style size-based formula
// (or, for CollectCountChunks, not expected to scale with input size at all —
// see its withName block): still give errorStrategy=retry something to work
// with by bumping both memory and time 50% per attempt, so a retry isn't just
// repeating the identical request that already failed.
def bumpByAttempt(base, attempt) {
    return base * (1 + 0.5 * (attempt - 1))
}

// ============================================================================
// PROFILES
// ============================================================================

profiles {

    // UNC LONGLEAF (SLURM)
    longleaf {

        params {
            deliver_src_dir = "${projectDir}/../src"
        }

        process {
            executor     = 'slurm'
            errorStrategy = 'retry'
            maxRetries   = 2

            // Default for small tasks
            cpus   = 1
            memory = 8.GB
            time   = '30m'

            withName: 'GenerateDecodeYaml' {
                memory = { bumpByAttempt(256.MB, task.attempt) }
                time   = { bumpByAttempt(2.min, task.attempt) }
            }

            withName: 'CONCAT' {
                cpus   = 4          // used by orad -t for .ora inputs; harmless for cat/zcat
                memory = { sizeMem(files, 1.5, 8, task.attempt) }
                time   = { 1.h * task.attempt }
            }

            // TEMPORARY — remove with the ORA_DIAGNOSTICS process
            withName: 'ORA_DIAGNOSTICS' {
                cpus   = 4          // used by orad -t for .ora inputs
                memory = 4.GB       // streaming counts — low memory
                time   = '2h'       // decodes all R1+R2 files in one task
            }

            withName: 'FASTP_MERGE' {
                module = 'fastp/1.0.1'
                cpus   = 8
                memory = { sizeMem([r1, r2], 1.2, 64, task.attempt) }
                time   = { 4.h * task.attempt }
                clusterOptions = '--ntasks=1 --cpus-per-task=8'
            }

            withName: 'FASTQC' {
                module = 'fastqc/0.12.1'
                cpus   = 8
                memory = { sizeMem(reads, 0.6, 16, task.attempt) }
                time   = { 2.h * task.attempt }
                clusterOptions = '--ntasks=1 --cpus-per-task=8'
            }

            withName: 'DECOMPRESS' {
                cpus   = 1
                memory = 4.GB
                time   = '1h'
            }

            withName: 'ExtractSequenceFiles' {
                memory = { bumpByAttempt(256.MB, task.attempt) }
                time   = { bumpByAttempt(4.min, task.attempt) }
            }

            // Worker-side FASTQ split (SPLIT process in deli.nf). NOTE:
            // requires `seqkit` on PATH — not installed by setup.sh; on
            // Longleaf load/install it (e.g. conda or a module) before
            // running the FASTQ entry point with this pipeline version.
            withName: 'SPLIT' {
                cpus   = 4
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { 4.h * task.attempt }
            }

            // memory stays fixed (see note above — chunk size is bounded by
            // params.chunk_size, not campaign size) but per-chunk runtime
            // still varies enough that a flat cap retries a slow chunk into
            // the same wall it just hit — 5 chunks did exactly that for the
            // full 12h of the 2026-08-18 SGCDEL Camp1 run and never finished.
            // Scale with task.attempt like the memory multipliers do.
            withName: 'DecodeChunk' {
                memory = 3.GB
                time   = { 10.min * task.attempt }
            }

            withName: 'CountChunk' {
                memory = 2.GB
                time   = { 10.min * task.attempt }
            }

            // NOTE: this is the single biggest resourcing risk in the pipeline.
            // sacct history shows MaxRSS sitting at exactly 148.GB (100% of the
            // cap) on every recent run that got close to it — it has not yet
            // OOM'd, but it has no headroom, and larger campaigns will push it
            // over. `deli decode collect` holds the whole sample's decoded rows
            // in memory at once; the multiplier below buys some room, but if a
            // campaign needs much more than ~300GB this hits real node-size
            // limits (general partition tops out around 115GB — this already
            // has to land on a bigmem-class node). Worth a conversation with
            // whoever owns DELi about a streaming/incremental collect instead
            // of scaling this further.
            withName: 'CollectDecodeChunks' {
                cpus   = 2
                memory = { sizeMem(decoded_files, 3.0, 160, task.attempt) }
                time   = { 45.min * task.attempt }
            }

            withName: 'CollectCountChunks' {
                cpus   = 1
                // streaming sink_parquet — memory not expected to scale with
                // input size (see sizeMem note above), so no sizeMem formula
                // here; still bump 50%/attempt like the fixed processes below
                // rather than retry into the identical historical ceiling.
                memory = { bumpByAttempt(2.GB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            withName: 'MergeDecodeStatistics' {
                memory = { bumpByAttempt(4.GB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            withName: 'SummarizeDecodeRun' {
                // Reads the whole sample's merged_counts.parquet — same input
                // class as NORMALIZE. sacct shows this already OOM'd 4/24 times
                // at the old fixed 4.GB.
                memory = { sizeMem(merged_counts, 10, 8, task.attempt) }
                time   = { 5.min * task.attempt }
            }

            withName: 'WriteDecodeReport' {
                memory = { bumpByAttempt(512.MB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            withName: 'BUILD_LIBRARY_DICT' {
                memory = { bumpByAttempt(2.GB, task.attempt) }
                time   = { bumpByAttempt(10.min, task.attempt) }
            }

            // Calibrated by directly profiling normalize.py (/usr/bin/time -v)
            // against all 6 SGCDEL Camp1 counts.parquet files, 36MB-1.1GB:
            // peak RSS fit peak_GB = 0.6 + 26.5 * size_GB almost exactly
            // (R^2 ~ 0.999) — polars adds several new string columns
            // (compound_id, per-cycle BB columns) well above the on-disk
            // size. The 35 multiplier below keeps ~30% headroom over that
            // fitted line rather than just matching it. sacct also shows
            // 15/29 historical runs OOM'd at the old fixed 16.GB.
            withName: 'NORMALIZE|NORMALIZE_CUSTOM' {
                memory = { sizeMem(counts_parquet, 35, 24, task.attempt) }
                time   = { 30.min * task.attempt }
            }

            withName: 'ADD_SMILES_LIB' {
                memory = { sizeMem(normalized_parquet, 10, 4, task.attempt) }
                time   = { 30.min * task.attempt }
            }

            withName: 'MERGE_SMILES' {
                memory = { sizeMem([normalized_parquet, partials], 10, 8, task.attempt) }
                time   = { 30.min * task.attempt }
            }

            withName: 'DEDUPLICATE' {
                memory = { sizeMem(counts_parquet, 14, 32, task.attempt) }
                time   = { 2.h * task.attempt }
            }

            withName: 'SINGLETON' {
                memory = { sizeMem(deduplicated_parquet, 14, 32, task.attempt) }
                time   = { 2.h * task.attempt }
            }

            withName: 'LABEL' {
                memory = { sizeMem(enriched_parquet, 10, 32, task.attempt) }
                time   = { 2.h * task.attempt }
            }

            withName: 'JOIN' {
                // sacct: 3/16 historical runs OOM'd at the old fixed 24.GB.
                memory = { sizeMem([singletons_parquet, disynthon_files], 16, 32, task.attempt) }
                time   = { 2.h * task.attempt }
            }
        }

        executor {
            queueSize       = 50
            submitRateLimit = '10 sec'
            exitReadTimeout = '15 min'
        }
    }


    gcp {
        workDir = "gs://${params.bucket}/deliver-results/"

        params {
            deliver_src_dir = "/opt/deliver/src"
        }

        process {
            executor      = 'google-batch'
            errorStrategy = 'retry'
            maxRetries    = 2
            container     = params.container
            cpus          = 1
            memory        = 8.GB
            time          = '30m'
            containerOptions = '--user root'

            // ----------------------------------------------------------------
            // Dynamic resources — same sizeMem()/bumpByAttempt() helpers as
            // the longleaf profile (defined above, outside the profiles).
            // The per-GB memory multipliers are the longleaf-calibrated ones
            // (real MaxRSS history / direct profiling — see the longleaf
            // blocks); they describe the processes, not the executor, so they
            // transfer as-is. The baseGB floors keep each process at (or
            // effectively at) its previous fixed GCP request, so small runs
            // cost the same as before while large campaigns scale up instead
            // of OOM-ing.
            //
            // GCP-specific notes:
            //  - Batch rounds cpus+memory up to the smallest machine type that
            //    fits, so some floors below are "free": e.g. 8 cpus already
            //    implies a 32 GB standard machine.
            //  - time keeps the old fixed GCP value as the attempt-1 base (GCS
            //    staging makes tasks slower than their longleaf equivalents)
            //    and scales with task.attempt so a retry isn't resubmitted
            //    into the same wall it just hit.
            //  - disk is dynamic on staging-heavy steps: inputs are staged
            //    from GCS onto the task VM, so required scratch scales with
            //    campaign size exactly like memory does (sizeMem's "N GB"
            //    string is a valid disk request too).
            //  - spot preemptions are retried by Batch itself (maxSpotAttempts
            //    below), so they don't bump the task.attempt scaling.
            // ----------------------------------------------------------------

            withName: 'GenerateDecodeYaml' {
                cpus   = 1
                memory = { bumpByAttempt(512.MB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            withName: 'CONCAT' {
                cpus   = 8
                // Streaming (cat / orad | gzip): 0.98 GB peak measured on the
                // 774M-read .ora campaign (2026-08-27 traces). The old
                // input-scaled formula would demand 240 GB+ on a 2B-read
                // campaign for a task that never grows — fixed request instead.
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { 4.h * task.attempt }
                // staged inputs (1x) + concatenated .fastq.gz output; .ora
                // inputs re-emitted as gzip grow several-fold on top of that
                disk   = { sizeMem(files, 10, 300, task.attempt) }
            }

            // TEMPORARY — remove with the ORA_DIAGNOSTICS process
            withName: 'ORA_DIAGNOSTICS' {
                cpus   = 8          // used by orad -t for .ora inputs
                memory = 8.GB       // streaming counts — low memory
                time   = '8h'       // decodes all R1+R2 files in one task
                disk   = '200 GB'   // only to STAGE the .ora inputs (no scratch written)
            }

            withName: 'FASTP_MERGE' {
                cpus   = 32
                // fastp's workers buffer output ahead of its single gzip
                // writer with NO backpressure: 97.9 GB peak on 54 GiB of
                // input (1.34B reads) = 1.8 GB/GiB. The old 1.2 multiplier
                // under-provisions that — a 32 GB machine thrashed for hours
                // on the 2026-08-27 .ora campaign. 3.0 GB/GiB is ~1.7× the
                // measured ratio; projected ~480 GB at a 2B-pair campaign
                // (fits n2d-highmem-64). Above ~250 GiB of input this exceeds
                // the biggest machines — switch fastp to uncompressed merged
                // output (kills the balloon) before going there.
                memory = { sizeMem([r1, r2], 3.0, 128, task.attempt) }
                time   = { 12.h * task.attempt }
                // staged r1+r2 (compressed) + merged.fastq.gz output
                disk   = { sizeMem([r1, r2], 6, 500, task.attempt) }
            }

            withName: 'FASTQC' {
                // Single-threaded Java per input file; fastqc_threads=2 (R1+R2)
                // is all it ever uses — 8 cpus were idle. Measured ≤0.9 GB RSS
                // and 58 min at 1.34B reads; memory is flat, so no input
                // scaling (the old formula would inflate the machine at 2B
                // reads). Time: ~2-3 h/file projected at 2B reads per file.
                cpus   = 4
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { 8.h * task.attempt }
                disk   = { sizeMem(reads, 3, 200, task.attempt) }    // staging + reports only
            }

            withName: 'DECOMPRESS' {
                cpus   = 8          // used by orad -t for .ora inputs
                memory = { bumpByAttempt(8.GB, task.attempt) }   // streaming — doesn't scale with input
                time   = { 4.h * task.attempt }
                // staged input (1x) + merged.fastq written UNCOMPRESSED (~4-8x input)
                disk   = { sizeMem(gz_file, 10, 400, task.attempt) }
            }

            withName: 'ExtractSequenceFiles' {
                cpus   = 1
                memory = { bumpByAttempt(512.MB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            // Worker-side FASTQ split (replaces the head-job splitFastq
            // operator — see the SPLIT process in deli.nf). Streaming with
            // multithreaded gzip: memory is flat; disk holds the staged
            // merged FASTQ + all chunks (≈2× input, compressed).
            withName: 'SPLIT' {
                cpus   = 8
                memory = { bumpByAttempt(8.GB, task.attempt) }
                // 8h base: a 62 GiB gzipped merged FASTQ (PARP14A campaign) ran
                // >3.5h per attempt — 4h left no headroom over staging + split,
                // and `time` becomes the hard Batch maxRunDuration kill deadline.
                time   = { 8.h * task.attempt }
                disk   = { sizeMem(merged_fastq, 4, 300, task.attempt) }
            }

            // Chunked steps: memory stays fixed (bounded by chunk size, not
            // campaign size — see the sizeMem note above), but per-chunk
            // runtime varies enough that a flat cap retries a slow chunk into
            // the same wall it just hit — scale time with task.attempt.
            withName: 'DecodeChunk' {
                cpus   = 2
                // 2.0 GB max measured per chunk (1.34B-read campaign): 3×
                // headroom, and attempt-scaled so an outlier chunk escalates
                // on retry instead of re-hitting the same ceiling.
                memory = { 6.GB * task.attempt }
                time   = { 30.min * task.attempt }
            }

            withName: 'CountChunk' {
                cpus   = 2
                // 0.31 GB max measured per chunk (>12× headroom), attempt-
                // scaled for retry escalation. Time headroom matters here:
                // UMI clustering is O(U²) per compound, so a deep-count
                // campaign can produce outlier chunks far slower than the
                // 1.4 min measured median.
                memory = { 4.GB * task.attempt }
                time   = { 30.min * task.attempt }
            }

            // Sized for the STREAMING collect (external-merge fix in the
            // DELi image): 2.2-2.4 GB peak measured flat at BOTH 774M and
            // 1.34B reads (2026-08-27 traces) — memory does not scale with
            // campaign size. Runtime is linear (~33 min at 1.34B reads →
            // ~1-2 h projected at 2B+), covered by the attempt-scaled cap.
            //
            // ⚠ If the image runs UNPATCHED DELi (e.g. a `build_and_push.sh
            // --github` baseline image), collect holds the whole sample in
            // RAM — restore the old request for those runs:
            //   memory = { sizeMem(decoded_files, 3.0, 160, task.attempt) }
            withName: 'CollectDecodeChunks' {
                cpus   = 4
                // memory = { sizeMem(decoded_files, 3.0, 160, task.attempt) }
                memory = { bumpByAttempt(16.GB, task.attempt) }
                time   = { 6.h * task.attempt }
                disk   = { sizeMem(decoded_files, 3, 500, task.attempt) }   // staged TSVs + uncompressed ndjson out
            }

            withName: 'CollectCountChunks' {
                cpus   = 2
                // streaming sink_parquet — memory doesn't scale with input
                // (90 MB measured); runtime does (12.8 min at 774M reads →
                // ~35-45 min projected at 2B+). 2 h base = ~3× that
                // projection — time headroom is free, OOM/timeout is not.
                memory = { bumpByAttempt(4.GB, task.attempt) }
                time   = { bumpByAttempt(2.h, task.attempt) }
                disk   = '100 GB'
            }

            withName: 'MergeDecodeStatistics' {
                cpus   = 2
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { bumpByAttempt(30.min, task.attempt) }
            }

            withName: 'SummarizeDecodeRun' {
                cpus   = 2
                // reads the whole merged_counts.parquet — scales like NORMALIZE
                memory = { sizeMem(merged_counts, 10, 8, task.attempt) }
                time   = { 30.min * task.attempt }
            }

            withName: 'WriteDecodeReport' {
                cpus   = 2
                memory = { bumpByAttempt(4.GB, task.attempt) }
                time   = { bumpByAttempt(15.min, task.attempt) }
            }

            withName: 'BUILD_LIBRARY_DICT' {
                cpus   = 1
                memory = { bumpByAttempt(4.GB, task.attempt) }
                time   = { bumpByAttempt(10.min, task.attempt) }
            }

            withName: 'NORMALIZE|NORMALIZE_CUSTOM' {
                cpus   = 1
                // longleaf-profiled: peak RSS ~ 0.6 + 26.5 * size_GB; the old
                // fixed 16 GB OOM'd 15/29 historical longleaf runs
                memory = { sizeMem(counts_parquet, 35, 24, task.attempt) }
                time   = { 30.min * task.attempt }
                disk   = '100 GB'
            }

            withName: 'ADD_SMILES_LIB' {
                cpus   = 1
                memory = { sizeMem(normalized_parquet, 10, 16, task.attempt) }
                time   = { 30.min * task.attempt }
                disk   = '100 GB'
            }

            withName: 'MERGE_SMILES' {
                cpus   = 1
                memory = { sizeMem([normalized_parquet, partials], 10, 16, task.attempt) }
                time   = { 30.min * task.attempt }
                disk   = '100 GB'
            }

            withName: 'DEDUPLICATE' {
                cpus   = 4
                memory = { sizeMem(counts_parquet, 14, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }

            withName: 'SINGLETON' {
                cpus   = 4
                memory = { sizeMem(deduplicated_parquet, 14, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }

            withName: 'LABEL' {
                cpus   = 4
                memory = { sizeMem(enriched_parquet, 10, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }

            withName: 'JOIN' {
                cpus   = 4
                memory = { sizeMem([singletons_parquet, disynthon_files], 16, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }
        }

        google {
            project  = params.project
            location = params.region
            // Client-side Google API timeouts. At the 1m default, a slow Batch
            // submit RPC can time out AFTER the job was created server-side;
            // the client's automatic retry of the same job name then dies with
            // ALREADY_EXISTS and aborts the whole session (open upstream bug
            // nextflow-io/nextflow#6916 — killed the 2026-08-22 test run at
            // 91%). A longer read timeout waits out slow responses instead of
            // phantom-creating jobs.
            httpConnectTimeout = '60 s'
            httpReadTimeout    = '270 s'
            batch {
                spot         = params.spot   // --spot false → on-demand VMs (see params.spot note)
                // Retry spot preemptions inside Batch rather than via
                // errorStrategy, so a preemption doesn't bump task.attempt and
                // needlessly inflate the attempt-scaled resources above.
                // (Newer Nextflow releases default this to 0.)
                maxSpotAttempts = 5
                bootDiskSize = '100 GB'
                network      = "projects/${params.project}/global/networks/default"
                subnetwork   = "projects/${params.project}/regions/${params.region}/subnetworks/default"
                serviceAccountEmail = params.service_account

                logsPolicy {
                    destination = 'CLOUD_LOGGING'
                }
            }
        }

        docker {
            enabled    = true
            runOptions = '-u 0:0'
        }

        cloudcache {
            enabled = true
            path    = 'gs://deliver-process/.nextflow/cache'
        }

        executor {
            queueSize       = 200
            submitRateLimit = '20 sec'
            exitReadTimeout = '30 min'
        }
    }


    gcp_test {
        workDir = "gs://${params.bucket}/deliver-results/"

        params {
            deliver_src_dir = "/opt/deliver/src"
        }

        process {
            executor      = 'google-batch'
            errorStrategy = 'retry'
            maxRetries    = 2
            container     = params.container
            cpus          = 1
            memory        = 8.GB
            time          = '30m'
            containerOptions = '--user root'

            // Dynamic resources — same conventions and calibrated multipliers
            // as the gcp profile above, keeping gcp_test's smaller old fixed
            // values as the floors.

            withName: 'GenerateDecodeYaml' {
                cpus   = 1
                memory = { bumpByAttempt(512.MB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            withName: 'CONCAT' {
                cpus   = 4
                memory = { bumpByAttempt(8.GB, task.attempt) }   // streaming; 0.98 GB measured
                time   = { 4.h * task.attempt }
                disk   = { sizeMem(files, 10, 100, task.attempt) }
            }

            // TEMPORARY — remove with the ORA_DIAGNOSTICS process
            withName: 'ORA_DIAGNOSTICS' {
                cpus   = 4          // used by orad -t for .ora inputs
                memory = 8.GB       // streaming counts — low memory
                time   = '8h'       // decodes all R1+R2 files in one task
                disk   = '100 GB'   // only to STAGE the .ora inputs (no scratch written)
            }

            withName: 'FASTP_MERGE' {
                cpus   = 8
                memory = { sizeMem([r1, r2], 3.0, 128, task.attempt) }
                time   = { 6.h * task.attempt }
                disk   = { sizeMem([r1, r2], 6, 100, task.attempt) }
            }

            withName: 'FASTQC' {
                cpus   = 4
                memory = { bumpByAttempt(8.GB, task.attempt) }   // flat; ≤0.9 GB measured
                time   = { 8.h * task.attempt }
                disk   = { sizeMem(reads, 3, 50, task.attempt) }
            }

            withName: 'DECOMPRESS' {
                cpus   = 4
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { 4.h * task.attempt }
                disk   = { sizeMem(gz_file, 10, 100, task.attempt) }
            }

            withName: 'ExtractSequenceFiles' {
                cpus   = 1
                memory = { bumpByAttempt(512.MB, task.attempt) }
                time   = { bumpByAttempt(5.min, task.attempt) }
            }

            withName: 'SPLIT' {
                cpus   = 4
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = { sizeMem(merged_fastq, 4, 100, task.attempt) }
            }

            withName: 'DecodeChunk' {
                cpus   = 2
                // 2.0 GB max measured per chunk (1.34B-read campaign): 3×
                // headroom, and attempt-scaled so an outlier chunk escalates
                // on retry instead of re-hitting the same ceiling.
                memory = { 6.GB * task.attempt }
                time   = { 30.min * task.attempt }
            }

            withName: 'CountChunk' {
                cpus   = 2
                // 0.31 GB max measured per chunk (>12× headroom), attempt-
                // scaled for retry escalation. Time headroom matters here:
                // UMI clustering is O(U²) per compound, so a deep-count
                // campaign can produce outlier chunks far slower than the
                // 1.4 min measured median.
                memory = { 4.GB * task.attempt }
                time   = { 30.min * task.attempt }
            }

            withName: 'CollectDecodeChunks' {
                cpus   = 4
                memory = { bumpByAttempt(16.GB, task.attempt) }
                // memory = { sizeMem(decoded_files, 3.0, 160, task.attempt) }   // ← for unpatched/patch DELi images 
                time   = { 3.h * task.attempt }
                disk   = { sizeMem(decoded_files, 3, 100, task.attempt) }
            }
         

            withName: 'CollectCountChunks' {
                cpus   = 2
                memory = { bumpByAttempt(4.GB, task.attempt) }
                time   = { bumpByAttempt(2.h, task.attempt) }   // scales with rows (12.8 min at 774M reads); generous on purpose
                disk   = '100 GB'
            }

            withName: 'MergeDecodeStatistics' {
                cpus   = 2
                memory = { bumpByAttempt(8.GB, task.attempt) }
                time   = { bumpByAttempt(30.min, task.attempt) }
            }

            withName: 'SummarizeDecodeRun' {
                cpus   = 2
                memory = { sizeMem(merged_counts, 10, 8, task.attempt) }
                time   = { 30.min * task.attempt }
            }

            withName: 'WriteDecodeReport' {
                cpus   = 2
                memory = { bumpByAttempt(4.GB, task.attempt) }
                time   = { bumpByAttempt(15.min, task.attempt) }
            }

            withName: 'BUILD_LIBRARY_DICT' {
                cpus   = 1
                memory = { bumpByAttempt(2.GB, task.attempt) }
                time   = { bumpByAttempt(10.min, task.attempt) }
            }

            withName: 'NORMALIZE|NORMALIZE_CUSTOM' {
                cpus   = 2
                memory = { sizeMem(counts_parquet, 35, 16, task.attempt) }
                time   = { 30.min * task.attempt }
                disk   = '50 GB'
            }

            withName: 'ADD_SMILES_LIB' {
                cpus   = 1
                memory = { sizeMem(normalized_parquet, 10, 8, task.attempt) }
                time   = { 1.h * task.attempt }
                disk   = '50 GB'
            }

            withName: 'MERGE_SMILES' {
                cpus   = 1
                memory = { sizeMem([normalized_parquet, partials], 10, 8, task.attempt) }
                time   = { 30.min * task.attempt }
                disk   = '50 GB'
            }

            withName: 'DEDUPLICATE' {
                cpus   = 1
                memory = { sizeMem(counts_parquet, 14, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }

            withName: 'SINGLETON' {
                cpus   = 1
                memory = { sizeMem(deduplicated_parquet, 14, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }

            withName: 'LABEL' {
                cpus   = 1
                memory = { sizeMem(enriched_parquet, 10, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }

            withName: 'JOIN' {
                cpus   = 1
                memory = { sizeMem([singletons_parquet, disynthon_files], 16, 32, task.attempt) }
                time   = { 2.h * task.attempt }
                disk   = '200 GB'
            }
        }

        google {
            project  = params.project
            location = params.region
            // Client-side Google API timeouts. At the 1m default, a slow Batch
            // submit RPC can time out AFTER the job was created server-side;
            // the client's automatic retry of the same job name then dies with
            // ALREADY_EXISTS and aborts the whole session (open upstream bug
            // nextflow-io/nextflow#6916 — killed the 2026-08-22 test run at
            // 91%). A longer read timeout waits out slow responses instead of
            // phantom-creating jobs.
            httpConnectTimeout = '60 s'
            httpReadTimeout    = '270 s'
            batch {
                spot         = params.spot   // --spot false → on-demand VMs (see params.spot note)
                // Retry spot preemptions inside Batch rather than via
                // errorStrategy, so a preemption doesn't bump task.attempt and
                // needlessly inflate the attempt-scaled resources above.
                // (Newer Nextflow releases default this to 0.)
                maxSpotAttempts = 5
                bootDiskSize = '100 GB'
                network      = "projects/${params.project}/global/networks/default"
                subnetwork   = "projects/${params.project}/regions/${params.region}/subnetworks/default"
                serviceAccountEmail = params.service_account

                logsPolicy {
                    destination = 'CLOUD_LOGGING'
                }
            }
        }

        docker {
            enabled    = true
            runOptions = '-u 0:0'
        }

        cloudcache {
            enabled = true
            path    = 'gs://deliver-process/.nextflow/cache'
        }

        executor {
            queueSize       = 200
            submitRateLimit = '20 sec'
            exitReadTimeout = '30 min'
        }
    }





    // LOCAL EXECUTION (Development / Mac)
    local {

        params {
            deliver_src_dir = "${projectDir}/../src"
        }

        process {
            executor = 'local'
            cpus     = 1
            memory   = 4.GB

            withName: 'CollectDecodeChunks|CollectCountChunks' {
                memory = 4.GB
            }
        }
    }

}

// ============================================================================
// EXECUTION REPORTING
// ============================================================================
// Per-task peak_rss/realtime for every run, so future resource tuning can use
// real per-task data instead of reconstructing it from sacct after the fact.
//
// Written alongside that run's launcher/nextflow logs (params.log_dir, set via
// submit.slurm's --log_dir) rather than a fixed pipeline_info/ dir under the
// DELIVER checkout, which every run on the box would otherwise share.

def timestamp = new Date().format('yyyyMMdd_HHmmss')
def reportDir = params.log_dir ?: "pipeline_info"

trace {
    enabled   = true
    file      = "${reportDir}/execution_trace_${timestamp}.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,status,exit,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem'
}

report {
    enabled   = true
    file      = "${reportDir}/execution_report_${timestamp}.html"
    overwrite = true
}

// ============================================================================
// MANIFEST
// ============================================================================

manifest {
    name        = 'DELIVER'
    description = 'DEL pipeline orchestration'
    version     = '0.1.0'
    mainScript  = 'pipeline/main.nf'
}
