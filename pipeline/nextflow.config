/*
 * DELIVER Pipeline Configuration
 *
 * Usage:
 *   nextflow run pipeline/main.nf -profile longleaf -params-file params.yml
 *
 * Profiles:
 *   longleaf  — UNC Longleaf HPC (SLURM)
 *   local     — local execution (development)
 */

// ============================================================================
// PARAMETERS
// ============================================================================

params {
    // Output
    out_dir         = null

    // Selection metadata (written into the generated decode.yaml)
    selection_id          = "selection"
    target_id             = "target"
    selection_condition   = "-"
    date_ran              = ""
    additional_info       = ""

    // FASTQ input files (for FULL and FROM_FASTQ)
    read_1         = null   // R1 files (list)
    read_2         = null   // R2 files (list), null = single-end

    // Libraries to decode against
    libraries             = []

    // Decode settings
    library_error_tolerance  = 2
    min_library_overlap      = 8
    revcomp                  = "YES"
    demultiplexer_algorithm  = "regex"
    demultiplexer_mode   = "single"
    realign                  = "NO"
    wiggle                   = "YES"

    // Preprocessing parameters
    fastp_threads   = 8    // increase for large files
    fastqc_threads  = 2    // one thread per input file (R1 [+ R2])
    ora_reference   = null // path to Illumina ORA reference (oradata) dir; only
                           // needed for reference-based .ora inputs (else leave null)

    // DELi runtime parameters
    deli_data_dir   = null
    config_file     = null
    chunk_size      = 1000000
    prefix          = ""
    debug           = false
    save_fastq_info = false
    save_failed     = false

    // Pre-counted parquet entry point (alternative to read_1)
    counts          = null

    // Deduplication behaviour when the same compound_id appears more than once:
    //   "fail" — abort and list the offending IDs (default; catches unexpected duplicates)
    //   "sum"  — merge duplicate rows by summing corrected_count (and raw_count if present)
    on_duplicate_compound_id = "fail"

    // Path to a pre-computed library_dict.json. When set, BUILD_LIBRARY_DICT is skipped.
    // Useful in counts mode when deli_data_dir is not available.
    library_dict = null
}

// ============================================================================
// DEFAULT PROCESS SETTINGS
// ============================================================================

process {
    cpus   = 1
    memory = 4.GB

    withName: 'CollectDecodeChunks' {
        memory = 16.GB
    }
}

// ============================================================================
// PROFILES
// ============================================================================

profiles {

    // UNC LONGLEAF (SLURM)
    longleaf {

        params {
            deliver_src_dir = "${projectDir}/../src"
        }

        process {
            executor     = 'slurm'
            errorStrategy = 'retry'
            maxRetries   = 2

            // Default for small tasks
            cpus   = 1
            memory = 8.GB
            time   = '30m'

            withName: 'GenerateDecodeYaml' {
                memory = 256.MB
                time   = '2m'
            }

            withName: 'CONCAT' {
                cpus   = 4          // used by orad -t for .ora inputs; harmless for cat/zcat
                memory = 5.GB
                time   = '1h'
            }

            // TEMPORARY — remove with the ORA_DIAGNOSTICS process
            withName: 'ORA_DIAGNOSTICS' {
                cpus   = 4          // used by orad -t for .ora inputs
                memory = 4.GB       // streaming counts — low memory
                time   = '2h'       // decodes all R1+R2 files in one task
            }

            withName: 'FASTP_MERGE' {
                module = 'fastp/1.0.1'
                cpus   = 8
                memory = 40.GB
                time   = '4h'
                clusterOptions = '--ntasks=1 --cpus-per-task=8'
            }

            withName: 'FASTQC' {
                module = 'fastqc/0.12.1'
                cpus   = 8
                memory = 16.GB
                time   = '2h'
                clusterOptions = '--ntasks=1 --cpus-per-task=8'
            }

            withName: 'DECOMPRESS' {
                cpus   = 1
                memory = 4.GB
                time   = '1h'
            }

            withName: 'ExtractSequenceFiles' {
                memory = 256.MB
                time   = '2m'
            }

            withName: 'DecodeChunk' {
                memory = 3.GB
                time   = '10m'
            }

            withName: 'CountChunk' {
                memory = 2.GB
                time   = '10m'
            }

            withName: 'CollectDecodeChunks' {
                cpus   = 2
                memory = 148.GB
                time   = '45m'
            }

            withName: 'CollectCountChunks' {
                cpus   = 1
                memory = 1.GB
                time   = '5m'
            }

            withName: 'MergeDecodeStatistics|SummarizeDecodeRun' {
                memory = 4.GB
                time   = '5m'
            }

            withName: 'WriteDecodeReport' {
                memory = 512.MB
                time   = '5m'
            }

            withName: 'BUILD_LIBRARY_DICT' {
                memory = 2.GB
                time   = '10m'
            }

            withName: 'NORMALIZE|NORMALIZE_CUSTOM' {
                memory = 16.GB
                time   = '30m'
            }

            withName: 'ADD_SMILES_LIB' {
                memory = 4.GB
                time   = '30m'
            }

            withName: 'MERGE_SMILES' {
                memory = 8.GB
                time   = '30m'
            }

            withName: 'DEDUPLICATE|SINGLETON|LABEL' {
                memory = 32.GB
                time   = '2h'
            }

            withName: 'JOIN' {
                memory = 24.GB
                time   = '2h'
            }
        }

        executor {
            queueSize       = 50
            submitRateLimit = '10 sec'
            exitReadTimeout = '15 min'
        }
    }


    gcp {
        workDir = "gs://${params.bucket}/deliver-results/"

        params {
            deliver_src_dir = "/opt/deliver/src"
        }

        process {
            executor      = 'google-batch'
            errorStrategy = 'retry'
            maxRetries    = 2
            container     = params.container
            cpus          = 1
            memory        = 8.GB
            time          = '30m'
            containerOptions = '--user root'

            withName: 'GenerateDecodeYaml' {
                cpus   = 1
                memory = 512.MB
                time   = '5m'
            }

            withName: 'CONCAT' {
                cpus   = 8
                memory = 32.GB
                time   = '4h'
                disk   = '300 GB'
            }

            // TEMPORARY — remove with the ORA_DIAGNOSTICS process
            withName: 'ORA_DIAGNOSTICS' {
                cpus   = 8          // used by orad -t for .ora inputs
                memory = 8.GB       // streaming counts — low memory
                time   = '8h'       // decodes all R1+R2 files in one task
                disk   = '200 GB'   // only to STAGE the .ora inputs (no scratch written)
            }

            withName: 'FASTP_MERGE' {
                cpus   = 32
                memory = 128.GB
                time   = '12h'
                disk   = '500 GB'
            }

            withName: 'FASTQC' {
                cpus   = 8
                memory = 32.GB
                time   = '4h'
                disk   = '200 GB'
            }

            withName: 'DECOMPRESS' {
                cpus   = 8
                memory = 32.GB
                time   = '4h'
                disk   = '400 GB'
            }

            withName: 'ExtractSequenceFiles' {
                cpus   = 1
                memory = 512.MB
                time   = '5m'
            }

            withName: 'DecodeChunk' {
                cpus   = 2
                memory = 4.GB
                time   = '30m'
            }

            withName: 'CountChunk' {
                cpus   = 2
                memory = 4.GB
                time   = '20m'
            }

            withName: 'CollectDecodeChunks|CollectCountChunks' {
                cpus   = 8
                memory = 240.GB
                time   = '6h'
                disk   = '500 GB'
            }

            withName: 'MergeDecodeStatistics|SummarizeDecodeRun' {
                cpus   = 2
                memory = 8.GB
                time   = '30m'
            }

            withName: 'WriteDecodeReport' {
                cpus   = 2
                memory = 4.GB
                time   = '15m'
            }

            withName: 'BUILD_LIBRARY_DICT' {
                cpus   = 1
                memory = 4.GB
                time   = '10m'
            }

            withName: 'NORMALIZE|NORMALIZE_CUSTOM' {
                cpus   = 1
                memory = 16.GB
                time   = '30m'
                disk   = '100 GB'
            }

            withName: 'ADD_SMILES_LIB' {
                cpus   = 1
                memory = 16.GB
                time   = '30m'
                disk   = '100 GB'
            }

            withName: 'MERGE_SMILES' {
                cpus   = 1
                memory = 16.GB
                time   = '30m'
                disk   = '100 GB'
            }

            withName: 'DEDUPLICATE|SINGLETON|LABEL' {
                cpus   = 4
                memory = 32.GB
                time   = '2h'
                disk   = '200 GB'
            }

            withName: 'JOIN' {
                cpus   = 4
                memory = 32.GB
                time   = '2h'
                disk   = '200 GB'
            }
        }

        google {
            project  = params.project
            location = params.region
            batch {
                spot         = true
                bootDiskSize = '100 GB'
                network      = "projects/${params.project}/global/networks/default"
                subnetwork   = "projects/${params.project}/regions/${params.region}/subnetworks/default"
                serviceAccountEmail = params.service_account

                logsPolicy {
                    destination = 'CLOUD_LOGGING'
                }
            }
        }

        docker {
            enabled    = true
            runOptions = '-u 0:0'
        }

        cloudcache {
            enabled = true
            path    = 'gs://deliver-process/.nextflow/cache'
        }

        executor {
            queueSize       = 200
            submitRateLimit = '20 sec'
            exitReadTimeout = '30 min'
        }
    }


    gcp_test {
        workDir = "gs://${params.bucket}/deliver-results/"

        params {
            deliver_src_dir = "/opt/deliver/src"
        }

        process {
            executor      = 'google-batch'
            errorStrategy = 'retry'
            maxRetries    = 2
            container     = params.container
            cpus          = 1
            memory        = 8.GB
            time          = '30m'
            containerOptions = '--user root'

            withName: 'GenerateDecodeYaml' {
                cpus   = 1
                memory = 512.MB
                time   = '5m'
            }

            withName: 'CONCAT' {
                cpus   = 4
                memory = 16.GB
                time   = '4h'
                disk   = '100 GB'
            }

            // TEMPORARY — remove with the ORA_DIAGNOSTICS process
            withName: 'ORA_DIAGNOSTICS' {
                cpus   = 4          // used by orad -t for .ora inputs
                memory = 8.GB       // streaming counts — low memory
                time   = '8h'       // decodes all R1+R2 files in one task
                disk   = '100 GB'   // only to STAGE the .ora inputs (no scratch written)
            }

            withName: 'FASTP_MERGE' {
                cpus   = 8
                memory = 32.GB
                time   = '12h'
                disk   = '100 GB'
            }

            withName: 'FASTQC' {
                cpus   = 4
                memory = 16.GB
                time   = '4h'
                disk   = '50 GB'
            }

            withName: 'DECOMPRESS' {
                cpus   = 4
                memory = 8.GB
                time   = '4h'
                disk   = '100 GB'
            }

            withName: 'ExtractSequenceFiles' {
                cpus   = 1
                memory = 512.MB
                time   = '5m'
            }

            withName: 'DecodeChunk' {
                cpus   = 2
                memory = 4.GB
                time   = '30m'
            }

            withName: 'CountChunk' {
                cpus   = 2
                memory = 4.GB
                time   = '20m'
            }

            withName: 'CollectDecodeChunks|CollectCountChunks' {
                cpus   = 4
                memory = 128.GB
                time   = '6h'
                disk   = '100 GB'
            }

            withName: 'MergeDecodeStatistics|SummarizeDecodeRun' {
                cpus   = 2
                memory = 8.GB
                time   = '30m'
            }

            withName: 'WriteDecodeReport' {
                cpus   = 2
                memory = 4.GB
                time   = '15m'
            }

            withName: 'BUILD_LIBRARY_DICT' {
                cpus   = 1
                memory = 2.GB
                time   = '10m'
            }

            withName: 'NORMALIZE|NORMALIZE_CUSTOM' {
                cpus   = 2
                memory = 16.GB
                time   = '30m'
                disk   = '50 GB'
            }

            withName: 'ADD_SMILES_LIB' {
                cpus   = 1
                memory = 8.GB
                time   = '1h'
                disk   = '50 GB'
            }

            withName: 'MERGE_SMILES' {
                cpus   = 1
                memory = 8.GB
                time   = '30m'
                disk   = '50 GB'
            }

            withName: 'DEDUPLICATE|SINGLETON|JOIN|LABEL' {
                cpus   = 1
                memory = 32.GB
                time   = '2h'
                disk   = '200 GB'
            }
        }

        google {
            project  = params.project
            location = params.region
            batch {
                spot         = true
                bootDiskSize = '100 GB'
                network      = "projects/${params.project}/global/networks/default"
                subnetwork   = "projects/${params.project}/regions/${params.region}/subnetworks/default"
                serviceAccountEmail = params.service_account

                logsPolicy {
                    destination = 'CLOUD_LOGGING'
                }
            }
        }

        docker {
            enabled    = true
            runOptions = '-u 0:0'
        }

        cloudcache {
            enabled = true
            path    = 'gs://deliver-process/.nextflow/cache'
        }

        executor {
            queueSize       = 200
            submitRateLimit = '20 sec'
            exitReadTimeout = '30 min'
        }
    }





    // LOCAL EXECUTION (Development / Mac)
    local {

        params {
            deliver_src_dir = "${projectDir}/../src"
        }

        process {
            executor = 'local'
            cpus     = 1
            memory   = 4.GB

            withName: 'CollectDecodeChunks|CollectCountChunks' {
                memory = 4.GB
            }
        }
    }

}

// ============================================================================
// MANIFEST
// ============================================================================

manifest {
    name        = 'DELIVER'
    description = 'DEL pipeline orchestration'
    version     = '0.1.0'
    mainScript  = 'pipeline/main.nf'
}
