// Rarefaction analysis — resource config for Longleaf.
// Inherits the main pipeline's profiles (longleaf / local / gcp).
includeConfig '../../pipeline/nextflow.config'

profiles {
    longleaf {
        process {
            withName: 'FIND_DECODED' {
                cpus   = 1
                memory = 2.GB
                time   = '10m'
            }
            withName: 'COLLECT_SUBSAMPLE' {
                // mirrors CollectDecodeChunks from the main pipeline
                cpus   = 2
                memory = 148.GB
                time   = '45m'
            }
            withName: 'COUNT_FRACTION' {
                // runs deli decode count on the full per-fraction ndjson (no splitting)
                cpus   = 2
                memory = 16.GB
                time   = '30m'
            }
            withName: 'RAREFACTION_SUMMARY' {
                cpus   = 1
                memory = 8.GB
                time   = '15m'
            }
        }
    }
}
